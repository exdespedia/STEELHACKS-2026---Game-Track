[sub_resource type="GDScript" id="GDScript_omia0"]
script/source = "extends Node3D

# so you're able to access dialogue ui
@onready var dialogue_ui = get_tree().current_scene.get_node(\"dialogue_ui/canvas\")
@onready var dialogue_animation = get_tree().current_scene.get_node(\"dialogue_ui/canvas/AnimationPlayer\")
@onready var speaker_name: RichTextLabel = get_tree().current_scene.get_node(\"dialogue_ui/canvas/speaker_name\")
@onready var dialogue_text: RichTextLabel = get_tree().current_scene.get_node(\"dialogue_ui/canvas/dialogue_text\")
@onready var player: CharacterBody3D = get_tree().current_scene.get_node(\"player\")

# arrays! arrays! arrays
@export var dialogues: Array[String]
@export var speaker_names: Array[String]
@export var speaker: Node3D

var currentDialogue = -1
var started = false

func _ready() -> void:
	dialogue_ui.visible = false
	dialogue_ui.get_node(\"continue\").connect(\"pressed\", Callable(self, \"continue_dialogue\"))
	
func start_dialogue(body):
	if body == player and !started:
		# make sure mouse can move here
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
		started = true
		player.speed = 0.0
		# TODO!!!!!!! LOOK IF SMTH DOESNT WORK THEN SWAP TO \"player\" or \"Head\"
		player.SENSITIVITY = 0.0
		dialogue_ui.visible = true
		continue_dialogue()

# remember to use speed not walk or run speed consts because we need var and not const
func end_dialogue():
	player.speed = 6.0
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	# TODO!!!!!!! LOOK IF SMTH DOESNT WORK THEN SWAP TO \"player\" or \"Head\"
	player.SENSITIVITY = 0.01
	dialogue_ui.visible = false
	

func continue_dialogue():
	currentDialogue += 1
	# only progress dialogue if there is dialogue to be progressed
	if currentDialogue < dialogues.size():
		if !dialogue_ui.visible:
			dialogue_ui.visible = true
			# tldr letters/named stored in array to be printed back out as dialogue
		dialogue_text.text = dialogues[currentDialogue]
		speaker_name.text = speaker_names[currentDialogue]
		dialogue_animation.play(\"RESET\")
		dialogue_animation.play(\"Scroll\")
	else:
		end_dialogue()
"

